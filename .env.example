# Kopieren nach .env.local (wird nicht committet) und Werte eintragen.

# Phase 1: Kennwort-Tür. Hash erzeugen:  printf '%s' 'DEIN-KENNWORT' | shasum -a 256
VITE_ZUGANG_KENNWORT_HASH=

# Phase 2: Datenquelle. local = wie bisher im Browser, supabase = Datenbank.
VITE_DATENQUELLE=local

# Supabase — nur revest-test, bis Timo live freigibt.
# Project Settings → API: Project URL und der öffentliche anon- bzw. publishable-Schlüssel.
# NIE den service_role- bzw. sb_secret_-Schlüssel eintragen — die App verweigert ihn.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
